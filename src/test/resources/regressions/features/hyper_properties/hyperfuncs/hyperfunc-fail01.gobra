package hyperfuncfail01

// ##(--hyperMode on)

// Relational expressions denote a single value for all executions. Positions in which they were silently
// replaced by `true` (issue 846) are now rejected.

// low as the result of a ghost function
ghost
ensures res
decreases
func test(x int) (res bool) {
	//:: ExpectedOutput(type_error)
	return low(x)
}

// low in the body of a pure function
ghost
decreases
pure func IsLow(x int) bool {
	//:: ExpectedOutput(type_error)
	return low(x)
}

// low in the contract of a pure function (not yet supported)
requires acc(x)
//:: ExpectedOutput(type_error)
ensures  low(r)
decreases
pure func Read(x *int) (r int) {
	return *x
}

// the body of a non-boolean hyperfunc must denote a single value
decreases
hyperfunc NotSingleValued(x int) int {
	//:: ExpectedOutput(type_error)
	return x + 1
}

decreases
hyperfunc H(x int) bool {
	return low(x)
}

// calls to hyperfuncs in the body of a pure function
ghost
decreases
pure func CallsH(x int) bool {
	//:: ExpectedOutput(type_error)
	return H(x)
}

ghost
decreases
pure func Id(b bool) bool {
	return b
}

// relational arguments to functions other than hyperfuncs
//:: ExpectedOutput(type_error)
requires Id(low(x))
func useId(x int)

// nested relational expressions
//:: ExpectedOutput(type_error)
requires low(rel(x, 0))
func nested(x int)

// relational values assigned to ghost variables
func ghostVar(x int) {
	//:: ExpectedOutput(type_error)
	ghost b := low(x)
}

type Itf interface {
	decreases
	hyperfunc M() bool
}

type Impl struct{}

// an interface hyperfunc must be implemented by a hyperfunc
ghost
decreases
pure func (i Impl) M() bool {
	return true
}

func useItf() {
	//:: ExpectedOutput(type_error)
	var x Itf = Impl{}
}

// relational conditions are only allowed in ghost if-statements
func nonGhostIf(t int) {
	//:: ExpectedOutput(type_error)
	if low(t) {
	}
}
