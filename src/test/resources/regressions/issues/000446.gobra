package issue446

type I interface {
    pred Mem()

    requires acc(Mem(), _)
    ensures  r >= 5
    pure F() (r int)
}

requires i != nil && i.Mem()
func client(i I) {
    x := i.F()
    assert x >= 4
}

type J interface {
    pred M()

    requires acc(M(), _)
    ensures  r <= 5
    pure G() (r int)
}

type S struct {
    X int
}

pred (s *S) M() {
    acc(s) && s.X > 5
}

//:: ExpectedOutput(generated_implementation_proof:postcondition_error)
requires acc(s.M(), _)
pure func (s *S) G() int {
    return unfolding acc(s.M(), _) in s.X
}

(*S) implements J