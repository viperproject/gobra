package hyperfuncsimple01

// ##(--hyperMode on)

// Hyperfuncs abstract over several executions. Non-interference is defined once and reused.
// `low` compares values with mathematical equality, so no comparability side conditions are needed
// for arguments of interface type.
decreases
hyperfunc NonInterf(input, output any) bool {
	return low(input) ==> low(output)
}

ensures NonInterf(input, output)
func F(input int) (output int) {
	output = input * 2 + 1
	return
}

//:: ExpectedOutput(postcondition_error:assertion_error)
ensures NonInterf(input, output)
func Bad(input int, secret int) (output int) {
	output = input + secret
	return
}

// A hyperfunc's precondition and postcondition can be relational, too.
requires low(x)
ensures  res
decreases
hyperfunc LowImpliesLowSquare(x int) (res bool) {
	return low(x * x)
}

requires low(x)
ensures  low(res)
func Square(x int) (res int) {
	assert LowImpliesLowSquare(x)
	return x * x
}

// Hyperfuncs are implicitly ghost and pure.
decreases
hyperfunc LowBoth(x, y int) bool {
	return low(x) && low(y)
}

requires LowBoth(x, y)
ensures  low(res)
func Add(x, y int) (res int) {
	return x + y
}
