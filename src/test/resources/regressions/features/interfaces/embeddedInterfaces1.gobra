package pkg

type foo3 interface {
	foo2
	foo1
}

type foo2 interface {
	H1()
}

type foo1 interface {
	foo
	
	ensures 0 <= res
	H() (res int)
}

type foo interface {
	bar
	
	F()
}

type bar interface {
	ensures res == 5
	pure G() (res int)
}

type test int

func (x test) F()

ensures res == 5
pure func (x test) G() (res int)

test implements foo

type test1 int

ensures 0 <= res
func (x test1) H() (res int)

ensures res == 5
pure func (x test1) G() (res int)

func (x test1) F()

test1 implements foo1

type test2 int

func (x test2) F()

ensures res == 5
pure func (x test2) G() (res int)

ensures 1 <= res
func (x test2) H() (res int)

func (x test2) H1()

func main() {
	y := test(0)
	assert y.G() == 5
	
	y1 := test1(0)
	assert y1.G() == 5
	tmp := y1.H()
	assert tmp >= 0

	var y2 bar = test1(0)
	var y3 foo = test1(0)
	var y4 foo1 = test1(0)

	var y5 foo = y4

	var y6 foo3 = test2(0)
	y6.H()
}
