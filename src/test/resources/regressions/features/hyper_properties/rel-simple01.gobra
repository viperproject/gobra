package relsimple01

// ##(--hyperMode extended --enableExperimentalHyperFeatures)

// rel(e, i) is defined only if execution i is active; the callee is verified for every activation
requires active(0) && active(1) ==> rel(i, 0) == rel(i, 1)
ensures  low(res)
func foo(i int) (res int) {
    return i + 42
}

requires active(0) && active(1) ==> rel(i, 0) < rel(i, 1)
ensures  active(0) && active(1) ==> rel(res, 0) < rel(res, 1)
func bar(i int) (res int) {
    return i + 42
}
