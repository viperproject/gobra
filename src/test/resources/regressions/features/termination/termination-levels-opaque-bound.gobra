package termination

// An opaque level constant keeps facts about it free of atoms. Comparisons with a revealed call
// see the atoms of its body. The termination check of a call compares the level constants
// with the caller's level statically, so a callee below a constant that is below the caller
// passes by transitivity, without hints.

type I interface {
	decreases
	M()
}

type S struct {
	x I
}

decreases
func f() {}

decreases
func g() {}

ghost
opaque
decreases
pure func Bound() level { return levelOf(f) + levelOf(g) }

ghost
requires x != nil && levelOf(x) < levelOf(f)
ensures  levelOf(x) < Bound()
decreases
func below(x I) {
	assert levelOf(x) < reveal Bound()
}

requires acc(&s.x, 1/2) && s.x != nil && levelOf(s.x) < Bound()
decreases
func use(s *S) {
	f()
	g()
	assert reveal Bound() < ownLevel()
	s.x.M()
}

requires acc(&s.x, 1/2) && s.x != nil && levelOf(s.x) < Bound()
decreases
func useWithoutHint(s *S) {
	f()
	g()
	s.x.M()
}

ghost
opaque
decreases
pure func TopBound() level { return levelOf(top) }

requires acc(&s.x, 1/2) && s.x != nil && levelOf(s.x) < TopBound()
decreases
func top(s *S) {
	//:: ExpectedOutput(function_termination_error)
	bottom(s)
}

// TopBound refers to top, which calls bottom: the bound is not below bottom
requires acc(&s.x, 1/2) && s.x != nil && levelOf(s.x) < TopBound()
decreases
func bottom(s *S) {
	//:: ExpectedOutput(function_termination_error)
	s.x.M()
}

requires x != nil
decreases
func helper(x I) {
	x.M()
}

// the level of the call is {helper} + levelOf(s.x), below the single atom of passOn
requires acc(&s.x, 1/2) && s.x != nil && levelOf(s.x) < Bound()
decreases
func passOn(s *S) {
	f()
	g()
	helper(s.x)
}
