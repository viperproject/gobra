package hyperfuncheap01

// ##(--hyperMode on)

// Hyper functions over the heap: SIF specs are layered on top of footprint specs (in the style of IDF).
type Person struct {
	id   int
	name string
	ssn  string
}

pred (p *Person) Mem() {
	acc(p)
}

ghost
requires p.Mem()
decreases
hyper pure func (p *Person) LowData() bool {
	return unfolding p.Mem() in low(p.id)
}

requires acc(p.Mem(), 1/2)
requires p.LowData()
ensures  acc(p.Mem(), 1/2)
ensures  low(id)
func (p *Person) GetID() (id int) {
	return unfolding acc(p.Mem(), 1/2) in p.id
}

// Updating a field that the hyper function does not constrain preserves it.
requires p.Mem() && p.LowData()
ensures  p.Mem() && p.LowData()
func (p *Person) UpdateName(name string) {
	unfold p.Mem()
	p.name = name
	fold p.Mem()
}

// Updating the id with high data does not.
requires p.Mem() && p.LowData()
//:: ExpectedOutput(postcondition_error:assertion_error)
ensures  p.Mem() && p.LowData()
func (p *Person) UpdateIDBad(id int) {
	unfold p.Mem()
	p.id = id
	fold p.Mem()
}

// The contents of a slice are low. The quantified variable `i` denotes the same index in both executions.
ghost
requires forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], _)
decreases
hyper pure func LowContents(s []int) bool {
	return low(len(s)) &&
		forall i int :: { &s[i] } 0 <= i && i < len(s) ==> low(s[i])
}

requires forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2)
requires LowContents(s)
ensures  forall i int :: { &s[i] } 0 <= i && i < len(s) ==> acc(&s[i], 1/2)
ensures  low(res)
func Sum(s []int) (res int) {
	invariant 0 <= i && i <= len(s) && low(i) && low(res)
	invariant forall j int :: { &s[j] } 0 <= j && j < len(s) ==> acc(&s[j], 1/2)
	invariant LowContents(s)
	for i := 0; i < len(s); i++ {
		res += s[i]
	}
	return res
}
