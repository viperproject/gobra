// ##(--hyperMode on)

package hyperfuncexperimentalfail01

// declaring hyperfuncs requires the flag --experimentalHyperfuncs

//:: ExpectedOutput(type_error)
hyperfunc NonInterf(input, output int) bool {
	return low(input) ==> low(output)
}

type T struct{}

//:: ExpectedOutput(type_error)
hyperfunc (t T) Low(x int) bool {
	return low(x)
}

ensures NonInterf(x, res)
func Double(x int) (res int) {
	return 2 * x
}
