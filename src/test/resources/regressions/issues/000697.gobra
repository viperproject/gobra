package issue000697

// ##(-I ./000697/)
import pkg "pkg"

type Impl struct{
    x *int
}

closed pred (impl Impl) Inv() {
    acc(impl.x)
}

func main() {
    x@ := 0

    cl :=   preserves acc(&x)
            func closureImpl() int {
                x += 42
                return x
            }

    proof cl implements pkg.ClosureSpec{Impl{&x}} {
        unfold Impl{&x}.Inv()
        res = cl() as closureImpl
        fold Impl{&x}.Inv()
    }

    impl := Impl{&x}
    fold impl.Inv()
    pkg.Invoke(cl, impl)
}
