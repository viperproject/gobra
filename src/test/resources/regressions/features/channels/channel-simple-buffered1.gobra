package pkg

pred VIsOne(v int) {
    v == 1
}

func main() {
  c := make(chan int, 1) // make a buffered channel
  c.Init(VIsOne{_}, PredTrue{})
  go foo(1, c)

  fold PredTrue{}()
  res, ok := <- c
  if (ok) {
    unfold VIsOne{_}(res)
    assert res == 1
  }
}

requires acc(c.SendChannel(), 1/2)
requires c.SendGivenPerm() == VIsOne{_}
requires c.SendGotPerm() == PredTrue{}
requires v == 1
func foo(v int, c chan int) {
    fold VIsOne{_}(v)
    c <- v
}
