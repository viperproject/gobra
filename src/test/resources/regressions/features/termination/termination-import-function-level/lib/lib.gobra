package lib

type Shower interface {
	decreases
	Show() int
}

type Lit struct{}

decreases
func (l Lit) Show() int { return 0 }

Lit implements Shower

ensures res != nil && levelOf(res) < ownLevel()
decreases
func MakeShower() (res Shower) { return Lit{} }
