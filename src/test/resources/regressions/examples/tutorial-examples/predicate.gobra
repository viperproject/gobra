package tutorial

type node struct {
	value int
	next *node
}

pred list(ptr *node) {
	acc(&ptr.value) && acc(&ptr.next) && (ptr.next != nil ==> list(ptr.next))
}

requires list(ptr)
ensures  list(ptr)
func testPredFail(ptr * node) {
	assert list(ptr) // succeeds
	// assert acc(&ptr.value) && acc(&ptr.next) // fails if uncommented
}

requires list(ptr)
ensures  list(ptr)
func testPred(ptr * node) {
	assert list(ptr)
	unfold list(ptr) // exchanges list(ptr) with its body
	assert acc(&ptr.value) && acc(&ptr.next) // succeeds
	fold list(ptr)   // folding back the predicate for the postcondition
}

requires list(ptr)
decreases
pure func head(ptr *node) int {
	return unfolding list(ptr) in ptr.value
}

requires p > 0
requires acc(list(ptr), p)
ensures  acc(list(ptr), p)
func (ptr *node) sum(ghost p perm) (res int) {
	unfold acc(list(ptr), p)
	res = ptr.value
	if ptr.next != nil {
		res += ptr.next.sum(p)
	}
	fold acc(list(ptr), p)
	return res
}

requires list(ptr)
decreases list(ptr)
pure func (ptr *node) contains(value int) bool {
	return unfolding list(ptr) in ptr.value == value || (ptr.next != nil && ptr.next.contains(value))
}
