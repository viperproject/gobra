package main

// ##(-I ./000416/ -I ./000416/importedImplementationPkg)
import pkg "importedImplementationPkg"
import "importedImplementationPkg/shape"

func main () {
  r@ := pkg.Rect{Width: 2, Height: 3}
  fold r.Mem()
  r.Area()
  Area(&r)
}

requires s != nil && s.Mem()
ensures  s != nil && s.Mem()
func Area(s shape.Shape) (ret int) {
  return s.Area()
}