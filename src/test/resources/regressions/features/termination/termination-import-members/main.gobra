// checks whether termination of imported members is assumed instead of re-checked

package termination

// ##(-I ./)
import f "foo"

decreases
func test() {
    foo := f.Foo{}
    f.Pure_foo_function()
    foo.Pure_foo_method()
    f.Foo_function()
    foo.Foo_method()
}
