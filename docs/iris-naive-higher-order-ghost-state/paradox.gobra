// Gobra rendition of the "naive higher-order ghost state" paradox from
// "Iris from the Ground Up" (Jung et al., JFP 2018).
//
// The idea of the paradox: if ghost state may store propositions *and* the
// content stored at a ghost name may mention that very name (no "later"
// guarding the recursion), then one can derive False.
//
// Propositions are modelled by Gobra predicate values (`pred()`), ghost names by
// ghost pointers to such values.
//
// Everything in this file has a body and is checked by Gobra, with exactly two
// exceptions: `NeverElim` and `NeverIntro`, the rules of the *persistent negation*
// `Never(p)` = `□ ¬p`. Gobra has no persistent magic wands, so these two rules
// are the (only) assumptions under which the function `Paradox` derives False.
//
// Verify with: java -Xss128m -jar gobra.jar -i paradox.gobra

package paradox

/*** Naive saved propositions ***/

// A cell stores a proposition. Taking the address of a field of type `pred()` is
// not supported, so the proposition is wrapped in an ADT.
ghost type Cell adt {
	Mk{
		prop pred()
	}
}

ghost type Name = gpointer[Cell]

// `Saved(g, p)` stands for `own g (ag p)`. Reading a ghost location with a
// wildcard permission yields a persistent fact.
pred Saved(g Name, p pred()) {
	acc(g, _) && *g == Mk{p}
}

// Agreement: two recordings at the same name agree on the proposition.
ghost
requires acc(Saved(g, p), _) && acc(Saved(g, q), _)
ensures  p == q
decreases
func SavedAgree(g Name, p pred(), q pred()) {
	unfold acc(Saved(g, p), _)
	unfold acc(Saved(g, q), _)
}

// The naive allocation rule: the proposition to be saved may depend on the name
// that is being allocated. In Iris this is `⊢ |==> ∃γ. own γ (ag (Φ γ))` for an arbitrary
// `Φ`, which is exactly what is unsound without a later modality; here it is
// instantiated with the proposition `A` defined below. Gobra's ghost heap
// allows it trivially: allocate the cell first, and then store `A{g}` into it.
// (gobra-libs' `resalgebra.Alloc(ra, e)` does not give this: `e` has to be chosen
// before the location name exists.)
ghost
ensures acc(Saved(g, A{g}), _)
decreases
func NaiveAlloc() (g Name) {
	g = new(Cell)
	*g = Mk{A{g}}
	fold Saved(g, A{g})
}

/*** Persistent negation ***/

// `Never(p)` stands for `□ ¬p`, i.e., `□ (p -∗ False)`: `p` is refutable, and this is a
// persistent fact. As in Iris, it can only be introduced from a refutation whose
// footprint is itself persistent (otherwise duplicating `Never(p)` would be unsound).
// This side condition cannot be expressed in Gobra and is thus a proof obligation
// on the (single) use of `NeverIntro` below.
//
// These two rules cannot be given bodies: they are the assumptions of the paradox.
pred Never(p pred())

ghost
requires acc(Never(p), _)
requires p()
ensures  false
decreases
func NeverElim(p pred())

ghost
requires p() --* false
ensures  acc(Never(p), _)
decreases
func NeverIntro(p pred())

/*** The paradoxical proposition ***/

// A(g) = ∃p. Saved(g, p) ∗ □ ¬p. By agreement, `p` is necessarily `A{g}` itself, so the
// existential can be eliminated and `A` is defined in terms of its own predicate value.
// (Gobra predicates are iso-recursive: `A{g}()` and its body are related by fold/unfold.)
pred A(g Name) {
	acc(Saved(g, A{g}), _) && acc(Never(A{g}), _)
}

/*** The derivation of False ***/

// Step 1: A{g}() is contradictory. It contains `Never(A{g})`, which is persistent, so we
// can re-fold a second copy of `A{g}()` and use it to run the refutation.
ghost
requires A{g}()
ensures  false
decreases
func notA(g Name) {
	unfold A{g}()
	fold A{g}()
	NeverElim(A{g})
}

// Step 2: A{g}() holds: `Saved(g, A{g})` is given, and its negation is established by Step 1.
ghost
requires acc(Saved(g, A{g}), _)
ensures  A{g}()
decreases
func isA(g Name) {
	// the footprint of this wand is empty
	package A{g}() --* false {
		notA(g)
	}
	NeverIntro(A{g})
	fold A{g}()
}

// Step 3: put everything together.
ghost
ensures false
decreases
func Paradox() {
	g := NaiveAlloc()
	isA(g)
	notA(g)
}
