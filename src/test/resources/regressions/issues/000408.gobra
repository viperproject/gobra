package issue408

type T interface{
    F() int
    pure G() int
}

type TImpl struct{}

func (x* TImpl) F() int {
    return 0
}

func test1() {
    var x T
    //:: ExpectedOutput(precondition_error:receiver_is_nil_error)
    x.F()
}

func test2() {
    var x T
    //:: ExpectedOutput(precondition_error:receiver_is_nil_error)
    _ := x.G()
}

requires x != nil
func test3(x T) {
    x.F()
    _ := x.G()
}

requires typeOf(x) == type[*int]
func test4(x T) {
    x.F()
    _ := x.G()
}