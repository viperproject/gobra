opaque
decreases
pure func (s *Raw) EqAbsInfoField(pkt io.Pkt, info io.AbsInfoField) bool {
	return let currseg := pkt.CurrSeg in
		info.AInfo == currseg.AInfo     &&
		info.UInfo == currseg.UInfo     &&
		info.ConsDir == currseg.ConsDir &&
		info.Peer == currseg.Peer
}

