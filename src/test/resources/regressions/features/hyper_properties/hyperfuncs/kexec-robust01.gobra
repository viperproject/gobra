// ##(--hyperMode on --hyperExecutions 4)

// Robust declassification (Zdancewic & Myers, CSFW'01) is a 4-safety property: an attacker who controls the
// untrusted inputs must not be able to influence what is declassified. The four executions form a square:
//
//                attack a   attack a'
//    secret s       0           2
//    secret s'      1           3
//
// If the attacker cannot distinguish s and s' under attack a, it cannot distinguish them under attack a' either.
package kexecrobust01

// the executions share the public inputs, the columns share the attack, and the rows share the secret
decreases
hyperfunc Square(pub, sec, att any) bool {
	return low(pub) &&
		rel(att, 0) === rel(att, 1) && rel(att, 2) === rel(att, 3) &&
		rel(sec, 0) === rel(sec, 2) && rel(sec, 1) === rel(sec, 3)
}

decreases
hyperfunc Robust(out any) bool {
	return rel(out, 0) === rel(out, 1) ==> rel(out, 2) === rel(out, 3)
}

type Salaries struct {
	alice, bob int
}

// Robust: the average is declassified; the attacker only chooses an offset that is added to it.
requires Square(dept, Salaries{alice, bob}, offset)
ensures  Robust(res)
func Report(dept, alice, bob, offset int) (res int) {
	avg := (alice + bob) / 2
	return dept * 1000 + avg + offset
}

// Not robust: whether a secret is released depends on the attacker's guess of the password. A wrong guess (column a)
// reveals nothing, a correct guess (column a') reveals the salary.
requires Square(dept, Salaries{pw, salary}, guess)
//:: ExpectedOutput(postcondition_error:assertion_error)
ensures  Robust(res)
func Leak(dept, pw, salary, guess int) (res int) {
	return salary * eq(guess, pw)
}

// 1 if x == y, and 0 otherwise (abstract, to keep the caller free of secret-dependent branches)
ensures x == y ==> r == 1
ensures x != y ==> r == 0
decreases
func eq(x, y int) (r int)

// Non-interference, stated with `low`, now relates all four executions; contracts using it compose as before.
requires low(x)
ensures  low(res)
func Inc(x int) (res int) {
	return x + 1
}

requires Square(dept, Salaries{alice, bob}, offset)
ensures  Robust(res)
func ReportWithHelper(dept, alice, bob, offset int) (res int) {
	d := Inc(dept)
	return d * 1000 + (alice + bob) / 2 + offset
}
