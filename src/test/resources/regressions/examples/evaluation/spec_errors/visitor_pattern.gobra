//:: IgnoreFile(/gobra/issue/1122/)
// The pure methods `accept` and `visitAddition` recurse through interface dispatch. Gobra cannot prove termination
// of pure interface methods whose implementations recurse through the interface (see the issue above), so this file
// is ignored until that is fixed. The measures below are the intended ones.
// Any copyright is dedicated to the Public Domain.
// http://creativecommons.org/publicdomain/zero/1.0/

package pkg

type node interface {
    pred mem()

    requires mem() && v.mem2()
    requires v != nil
    decreases mem(), 1
    pure accept(v visitor) int
}

// variable

type variable struct {
  id int
}

requires self.mem() && v.mem2()
requires v != nil
decreases self.mem(), 1
pure func (self *variable) accept(v visitor) int {
  return v.visitVariable(self)
}

pred (self *variable) mem() { acc(self) && 0 <= self.id && self.id < 10 }



// constant

type constant struct {
  value int
}

requires self.mem() && v.mem2()
requires v != nil
decreases self.mem(), 1
pure func (self *constant) accept(v visitor) int {
  return v.visitConstant(self)
}

pred (self *constant) mem() { acc(self) }


// addition


type addition struct {
  left, right node
}

requires self.mem() && v.mem2()
requires v != nil
decreases self.mem(), 1
pure func (self *addition) accept(v visitor) int {
  return v.visitAddition(self)
}

pred (self *addition) mem() { acc(self) && self.left.mem() && self.right.mem() && self.left != nil && self.right != nil }


// visitor

type visitor interface {
  pred mem2()

  requires mem2() && v.mem()
  decreases
  pure visitVariable(v *variable) int

  requires mem2() && c.mem()
  decreases
  pure visitConstant(c *constant) int

  requires mem2()
  decreases a.mem(), 0
  pure visitAddition(a *addition) int
}

// children count

type childrenCounter struct{ f int }

pred (self *childrenCounter) mem2() { true }

decreases
pure func (self *childrenCounter) visitVariable(v *variable) int {
  return 1
}

decreases
pure func (self *childrenCounter) visitConstant(c *constant) int {
  return 1
}

requires self.mem2() && a.mem()
decreases a.mem(), 0
pure func (self *childrenCounter) visitAddition(a *addition) int {
  return unfolding a.mem() in (a.left.accept(self) + a.right.accept(self))
}

(*childrenCounter) implements visitor {
  //:: ExpectedOutput(precondition_error)
  pure (self *childrenCounter) visitAddition(c *addition) int { return self.visitAddition(c) }
}

func childrenCounter_client() {

  ev := &childrenCounter{}
  fold ev.mem2()

  var a node = &variable{0}
  fold a.mem()

  var b node = &constant{42}
  fold b.mem()

  c := &addition{a, b}
  fold c.mem()

  res := ev.visitAddition(c)
}


// evaluator

type evaluator struct {
    store [10]int
}

pred (self *evaluator) mem2() { acc(self) }

requires self.mem2() && v.mem()
decreases
pure func (self *evaluator) visitVariable(v *variable) int {
  return unfolding self.mem2() in (self.store)[unfolding v.mem() in v.id]
}

requires c.mem()
decreases
pure func (self *evaluator) visitConstant(c *constant) int {
  return unfolding c.mem() in c.value
}


requires self.mem2() && a.mem()
decreases a.mem(), 0
pure func (self *evaluator) visitAddition(a *addition) int {
  return unfolding a.mem() in (a.left.accept(self) + a.right.accept(self))
}


(*evaluator) implements visitor {
  //:: ExpectedOutput(precondition_error)
  pure (self *evaluator) visitAddition(c *addition) int { return self.visitAddition(c) }
}

func evaluator_client() {

  ev := &evaluator{store: [10]int{0: 7, 4: 99}}
  fold ev.mem2()

  var a node = &variable{0}
  fold a.mem()

  var b node = &constant{42}
  fold b.mem()

  c := &addition{a, b}
  fold c.mem()

  res := ev.visitAddition(c)
  assert res == 49
}



ensures res ==> (typeOf(n) == type[*variable] || typeOf(n) == type[*constant] || typeOf(n) == type[*addition])
func isAstNode(n node) (res bool) {
  if v, ok := n.(*variable); ok {
    return true
  } else if c, ok := n.(*constant); ok {
    return true
  } else if a, ok := n.(*addition); ok {
    return true
  } else {
    return false
  }
}
