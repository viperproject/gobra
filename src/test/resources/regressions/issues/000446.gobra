package issue446

type I interface {
    pred mem()

    requires mem()
    ensures  r >= 5
    decreases
    pure f() (r int)
}

requires i != nil && i.mem()
func client(i I) {
    x := i.f()
    assert x >= 4
}

type J interface {
    pred m()

    requires m()
    ensures  r <= 5
    decreases
    pure g() (r int)
}

type S struct {
    x int
}

pred (s *S) m() {
    acc(s) && s.x > 5
}

//:: ExpectedOutput(generated_implementation_proof:postcondition_error)
requires s.m()
decreases
pure func (s *S) g() int {
    return unfolding s.m() in s.x
}

(*S) implements J
