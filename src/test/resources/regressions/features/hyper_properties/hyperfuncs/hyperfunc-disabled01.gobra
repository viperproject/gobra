package hyperfuncdisabled01

// Without hyper mode, hyperfuncs are dropped and calls to them are treated like `low`: they are accepted in
// members without proof obligations.
// ##(--hyperMode off)

decreases
hyperfunc NonInterf(input, output any) bool {
	return low(input) ==> low(output)
}

ensures NonInterf(input, output)
func Abstract(input int) (output int)

func client() {
	x := Abstract(1)
}

// Note: in members with proof obligations, calls to hyperfuncs are reported as consistency errors (like `low`).
