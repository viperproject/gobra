package floats

// Floats cannot be boxed into interface values: interfaces require types for
// which Gobra's structural equality coincides with Go's equality (see
// isIdentityPreservingType), which does not hold for floats under IEEE 754
// semantics (NaN != NaN and +0.0 == -0.0 in Go).
func ifaceFloat(x float64) {
	//:: ExpectedOutput(type_error)
	var i interface{} = x
	_ = i
}

// Arrays containing floats cannot be compared: the encoding compares arrays
// structurally, which deviates from Go's semantics for NaN and ±0.0 elements.
func arrayCompare(x float64) {
	a := [2]float64{x, 1.0}
	b := [2]float64{x, 1.0}
	//:: ExpectedOutput(type_error)
	assert a != b
}

type vec struct {
	elems [2]float64
}

// The same applies to structs that contain such arrays.
func nestedArrayCompare(s vec, t vec) {
	//:: ExpectedOutput(type_error)
	assert s == t
}

// Map keys cannot contain floats: keys are compared structurally, whereas in
// Go, NaN keys are unretrievable and +0.0/-0.0 are the same key.
//:: ExpectedOutput(type_error)
func mapFloatKey(m map[float64]int) {
	_ = m
}

type wrapped struct {
	f float64
}

// The float checks are recursive: a struct with a float field is also
// rejected as a map key ...
//:: ExpectedOutput(type_error)
func mapStructKey(m map[wrapped]int) {
	_ = m
}

type myFloat float64

// ... and defined types with a float underlying type are treated as floats.
//:: ExpectedOutput(type_error)
func mapDefinedKey(m map[myFloat]int) {
	_ = m
}

type matrix struct {
	rows [2][2]float64
}

// Floats nested arbitrarily deep in arrays inside structs make the type
// non-comparable.
func deeplyNestedCompare(a matrix, b matrix) {
	//:: ExpectedOutput(type_error)
	assert a == b
}
