package trivial

type Tree struct {
  Left  *Tree
  Value int
  Right *Tree
}

pred TreeP(self *Tree) {
  acc(&self.Left) && acc(&self.Value) && acc(&self.Right) &&
  (self.Left != nil ==> TreeP(self.Left)) &&
  (self.Right != nil ==> TreeP(self.Right))
}

requires self != nil ==> TreeP(self)
ensures  self != nil ==> TreeP(self)
func (self *Tree) Contains(v int) (res bool) {
  if self == nil { res = false
  } else {
    unfold TreeP(self)
    if self.Value == v { res = true } else {
      res = (self.Left).Contains(v) || (self.Right).Contains(v)
    }
    fold TreeP(self)
  }
}
