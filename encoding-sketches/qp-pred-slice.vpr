// Viper counterpart of the following Gobra program, with the structs replaced
// by fields on `Ref`:
//
//   type Y struct { y bool }        ~>   field Y_y: Bool
//   type X struct { y *Y }          ~>   field X_y: Ref
//
// The slice `[]*X` is modelled the way Gobra models shared arrays: `loc(a, i)`
// is the address of the i-th slot (i.e. `&x[i]`), and the element `x[i]` — a
// `*X` — is the value stored in that slot, `loc(a, i).val`.

field Y_y: Bool
field X_y: Ref
field val: Ref

domain ShArray {
  function loc(a: ShArray, i: Int): Ref
  function first(r: Ref): ShArray
  function second(r: Ref): Int
  function alen(a: ShArray): Int

  // the slots of an array are pairwise distinct
  axiom all_diff {
    forall a: ShArray, i: Int :: {loc(a, i)}
      0 <= i && i < alen(a) ==> first(loc(a, i)) == a && second(loc(a, i)) == i
  }

  axiom len_nonneg {
    forall a: ShArray :: {alen(a)} 0 <= alen(a)
  }
}

// pred (x *X) Inv() { acc(x) && (x.y != nil ==> acc(x.y)) }
// Removing `x.X_y != null ==>` makes the last assertion provable.
predicate Inv(x: Ref) {
  acc(x.X_y) && (x.X_y != null ==> acc(x.X_y.Y_y))
}

// pred XsInv(x []*X) {
//   forall i int :: {x[i]} 0 <= i && i < len(x) ==> acc(&x[i]) && acc(x[i].Inv())
// }
predicate XsInv(a: ShArray) {
  forall i: Int :: {loc(a, i)}
    0 <= i && i < alen(a) ==> acc(loc(a, i).val) && acc(Inv(loc(a, i).val))
}

method f(a: ShArray)
  requires acc(XsInv(a), write)
{
  unfold acc(XsInv(a), write)

  assert forall i: Int, j: Int :: {loc(a, i).val, loc(a, j).val}
    0 <= i && i < j && j < alen(a) ==> i != j

  // Below assertion fails
  assert forall i: Int, j: Int :: {loc(a, i).val, loc(a, j).val}
    0 <= i && i < j && j < alen(a) ==>
      (unfolding acc(Inv(loc(a, i).val), write) in i != j)
}
