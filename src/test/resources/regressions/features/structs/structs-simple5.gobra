package pkg

// tests that a struct field name does not have to be unique
type A int
type B = int

type Test struct {
	a A
	BP B
}

requires noPerm < p && p <= writePerm
requires acc(t, p)
ensures acc(t, p)
ensures res == t.BP
func (t *Test) B(ghost p perm) (res int) {
	res = t.BP
	return
}

func main() {
	t := &Test{0, 42}
	res := t.B(1/2)
	assert(res == 42)
}
