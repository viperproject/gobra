package pkg

func main() {
	x@ := 0
	// Closure cannot be made opaque
	//:: ExpectedOutput(type_error)
	c := requires acc(&x, _)
		 ensures m == x + n
		 opaque
		 pure func f(n int) (m int) {
			return x + n
		 }
}
