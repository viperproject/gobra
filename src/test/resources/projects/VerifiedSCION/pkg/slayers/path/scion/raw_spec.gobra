func XoverRightSeg(raw []byte, currInfIdx int, currHfIdx int, segs io.SegLens) {
	prevSegLen := segs.LengthOfPrevSeg(currHfIdx)
	segLen := segs.LengthOfCurrSeg(currHfIdx)
