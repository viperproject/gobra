package trivial;

requires acc(p);
ensures acc(p) && *p == v;
func assign(p *int, v int) {
  *p = v;
};

func pointer1() {
  i@ := 5;
  p := &i;
  *p = 7;
  assert i == 7;
};

func pointer2() {
  i@ := 5;
  assign(&i, 7);
  assert i == 7;
};

requires acc(p) && acc(q);
ensures acc(p) && acc(q);
ensures *p == old(*q);
ensures *q == old(*p);
func swap(p, q *int) {
  tmp := *p;
  *p = *q;
  *q = tmp;
};

func pointer3() {
  i@ := 5;
  j@ := 7;
  swap(&i, &j);
  assert i == 7;
};

type Point struct {
  X int;
  Y int;
};


func OriginV() (r Point) {
  r = Point{0, 0};
};


func mirror() {
  p := Point{5, 7};
  assert p.X == 5;
  tmp := p.X;
  p.X = p.Y;
  p.Y = tmp;
  assert p.X == 7;
};

ensures acc(&r.X) && r.X == 0;
ensures acc(&r.Y) && r.Y == 0;
func Origin() (r *Point) {
  r = &Point{0, 0};
};

