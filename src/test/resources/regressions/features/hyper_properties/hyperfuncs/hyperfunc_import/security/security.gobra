// ##(--hyperMode on)

// A small library of security definitions, defined once as hyperfuncs and reused by clients.
package security

// Non-interference: if the inputs agree in both executions, so do the outputs.
decreases
hyperfunc NonInterf(input, output any) bool {
	return low(input) ==> low(output)
}

// Delimited release: the outputs may depend on the secrets only via the escape hatch.
decreases
hyperfunc DelimitedRelease(input, escapeHatch, output any) bool {
	return low(input) && low(escapeHatch) ==> low(output)
}

// Value-dependent classification in the style of SecCSL: `x` is low whenever the classification `isLow` says so.
decreases
hyperfunc Sens(x any, isLow bool) bool {
	return low(isLow) && (isLow ==> low(x))
}
