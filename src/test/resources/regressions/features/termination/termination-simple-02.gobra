package termination

type FactEven interface {
	requires n >= 0
	decreases n
	FactOfEven(n int) int
}

type FactOdd interface {
	requires n >= 0
	decreases n
	FactOfOdd(n int) int
}

type FactEvenImpl struct {}

requires v >= 0
decreases v
func(x FactEvenImpl) FactOfEven(v int) int {
	if v == 0 {
		return 1
	} else {
		var y FactOdd = FactOddImpl{}
		return v * y.FactOfOdd(v-1)
	}
}

type FactOddImpl struct {}

requires v >= 0
decreases v
func(y FactOddImpl) FactOfOdd(v int) int {
	if v == 0 {
		return 1
	} else if v == 1 {
		return 1
	} else {
		var y FactEven = FactEvenImpl{}
		return v * y.FactOfEven(v-1)
	}
}

type IsEven interface {
	requires n >= 0
	decreases n
	Even(n int) bool
}

type IsOdd interface {
	requires n >= 0
	decreases n
	Odd(n int) bool
}

type IsEvenImpl struct {}

requires n >= 0
decreases n
func(y IsEvenImpl) Even(n int) bool {
	if n == 0 {
		return true
	} else {
		var y IsOdd = IsOddImpl{}
		return y.Odd(n-1)
	}
}

type IsOddImpl struct {}

requires n >= 0
decreases n
func (y IsOddImpl) Odd(n int) bool {
	if n == 0 {
		return true
	} else {
		var y IsEven = IsEvenImpl{}
		return y.Even(n-1)
	}
}

type Infinite interface {
	// the following measure is no longer allowed since PR 918
	// decreases _
	Inf(n int) int
}

type InfiniteImpl struct {}

func (y InfiniteImpl) Inf(n int) int {
	return y.Inf(n)
}

(InfiniteImpl) implements Infinite {
	(i InfiniteImpl) Inf(n int) int {
		return i.Inf(n)
	}
}