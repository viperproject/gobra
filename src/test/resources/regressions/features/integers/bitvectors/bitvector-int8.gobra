decreases
func unop_int8(x int8) {
	if x == 0 {
		assert ^x == -1
	}
	if x == 1 {
		assert ^x == -2
	}
	if x == -1 {
		assert ^x == 0
	}
	if x == -128 {
		assert ^x == 127
	}
	if x == 127 {
		assert ^x == -128
	}
	if x == 85 {
		assert ^x == -86
	}
	if x == -6 {
		assert ^x == 5
	}
	if x == 100 {
		assert ^x == -101
	}
}

