package pkg

type A interface {
	pure F() int
}

type B interface {
	A
	pure G() int
}

type X struct {
	x int
}

pure func (self *X) F() int {
	return 0
}

type Y struct {
	y int
}

pure func (self *Y) F() int {
	return 1
}

pure func (self *Y) G() int {
	return 2
}

(*X) implements A

(*Y) implements B

func test() {
	y := &Y{4}
	var b B = y
	assert y.F() == 1
	assert b.G() == 2
	assert b.F() == 1
}
