package pkg

type foo interface {
	pred Mem()

	requires Mem()
	Bar() int
}

type t uint64

preserves x.Mem()
func (x t) Bar() int {
	return 1
}

pred (x t) Mem() { true }

pred mem2(x *t) { acc(x) }

t implements foo

(*t) implements foo {
	pred Mem := mem2

	(x *t) Bar() (res int) {
		unfold mem2(x)
		fold (*x).Mem()
		res = x.Bar()
		fold mem2(x)
	}
}
