package main

// ##(-I ./)
import foo "foo"

func test1() {
    c := pure func f() (r int) {
            return 2
         }

    proof c implements foo.P2{0} {
        r = c() as f
    }

    r := c() as foo.P2{0}
    assert r == 2
}

func test2() {
    c := ensures r == x + 2
         func f(x int) (r int) {
           return x + 2
         }

    proof c implements foo.P2 {
        r = c(x) as f
    }

    r := c(5) as foo.P2
    assert r == 7
}

func test3() {
    c := foo.S1{2}.Getx 

    proof foo.S1{2}.Getx implements foo.Ret2 {
        return foo.S1{2}.Getx()
    }

    assert c() as foo.Ret2 == 2
}

func test4() {
    var i foo.I1

    //:: ExpectedOutput(method_object_nil_error)
    c := i.Getx
}

func test5() {
    var i foo.I1
    i = foo.S1{2}

    c := i.Getx

    proof i.Getx implements foo.Ret2 {
        return i.Getx()
    }

    assert c() as foo.Ret2 == 2
}