package pkg

// ##(-I ./)
import b "bar"

requires e != nil
func foo(e b.Error) int {
    // this works since we explicitly specify that the Error interface from package bar should be used:
    // (the interface must be exported so that importing packages may reference it)
    return e.Test()
}
