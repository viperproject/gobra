package floats

func reflexivity(x float64) {
	//:: ExpectedOutput(assert_error)
	assert x == x // fails: x may be NaN
}

func quantifiedReflexivity() {
	//:: ExpectedOutput(assert_error)
	assert forall x float64 :: x == x // fails: NaN is a counterexample
}

func associativity(x float32, y float32, z float32) {
	//:: ExpectedOutput(assert_error)
	assert (x+y)+z == x+(y+z) // fails: float addition is not associative
}
