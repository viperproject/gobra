decreases
func unop_int16(x int16) {
	if x == 0 {
		assert ^x == -1
	}
	if x == 1 {
		assert ^x == -2
	}
	if x == -1 {
		assert ^x == 0
	}
	if x == -32768 {
		assert ^x == 32767
	}
	if x == 32767 {
		assert ^x == -32768
	}
	if x == 21845 {
		assert ^x == -21846
	}
	if x == -1234 {
		assert ^x == 1233
	}
}

