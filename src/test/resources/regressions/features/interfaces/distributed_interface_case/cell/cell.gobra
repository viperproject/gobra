package cell

type Cell struct { V int }

// implementation of Cell
requires acc(c, 1/2)
ensures res == c.V
pure func (c *Cell) GetVal() (res int) {
    return c.V
}

requires acc(c)
ensures acc(c) && c.V == v
func (c *Cell) SetVal(v int) {
    c.V = v
}
