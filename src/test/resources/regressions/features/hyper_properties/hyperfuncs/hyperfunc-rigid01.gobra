package hyperfuncrigid01

// ##(--hyperMode on)

// Rigid parameters: a hyperfunc parameter `c` with the top-level precondition `low(c)` has the same value in all
// executions, so the body and the postcondition may use it as a single value. Call sites must establish `low(c)`.
requires low(c)
decreases
hyperfunc ScaledDiff(x int, c int) int {
	return c * (rel(x, 0) - rel(x, 1))
}

requires low(c)
ensures ScaledDiff(res, 1) == ScaledDiff(x, c)
func Scale(x int, c int) (res int) {
	return c * x
}

// The call site does not establish `low(c)`.
func BadCall(x int, c int) {
	//:: ExpectedOutput(precondition_error:assertion_error)
	assert ScaledDiff(x, c) == ScaledDiff(x, c)
}

// A recursive hyperfunc with a rigid bound: the number of positions below n at which s differs in the executions
// (the Hamming distance used for neighbouring datasets in differential privacy).
requires low(n) && 0 <= n && n <= len(s)
decreases n
hyperfunc Hamming(s seq[int], n int) int {
	return n == 0 ? 0 : Hamming(s, n - 1) + (rel(s[n - 1], 0) == rel(s[n - 1], 1) ? 0 : 1)
}

ghost
requires 2 <= len(s) && low(len(s)) && low(s[0])
ensures Hamming(s, 2) <= 1
decreases
func FirstLow(s seq[int]) {
	assert Hamming(s, 0) == 0
	assert Hamming(s, 1) == 0
}

ghost
requires 1 <= len(s) && low(len(s))
//:: ExpectedOutput(postcondition_error:assertion_error)
ensures Hamming(s, 1) == 0
decreases
func NotLow(s seq[int]) {}
