// Triggers are unary (rejected by Viper's type checker, since relational constructs are not valid triggers).
method triggers(s: Seq[Int])
  //:: ExpectedOutput(typechecker.error)
  requires forall k: Int :: { rel(s[k], 0) } 0 <= k && k < |s| ==> low(s[k])
