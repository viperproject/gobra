package pkg

// ##(-I ./)
import shape "shape"

type Rect struct {
  Width int
  Height int
}

pred (r *Rect) Mem() {
  acc(r, 1/2)
}

requires acc(r, _)
pure func (r *Rect) Size() bool {
  return r.Width >= 0 && r.Height >= 0
}

requires acc(r, 1/2)
ensures  acc(r, 1/2)
func (r *Rect) Area() (ret int) {
  return r.Width * r.Height
}

(*Rect) implements shape.Shape {
  pure (r *Rect) Size() bool {
    return unfolding acc(r.Mem(), 1/2) in r.Size()
  }

  (r *Rect) Area() (ret int) {
    unfold r.Mem()
    ret = r.Area()
    fold r.Mem()
  }
}